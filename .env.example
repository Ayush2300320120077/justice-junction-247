# Justice Junction — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. This file (.env.example) must contain ONLY placeholders.

# ── DATABASE ──────────────────────────────────────────────
# MongoDB Atlas connection string. Rotate this password immediately if it was ever committed.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/justicejunction?retryWrites=true&w=majority

# ── AUTH ──────────────────────────────────────────────────
# Use a long random string (32+ characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ── RAZORPAY ──────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/ — use test keys for dev, live keys for prod
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── AI (Anthropic Claude) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── AI (RAG / Vector Pipeline) ────────────────────────────
VOYAGE_API_KEY=your_voyage_api_key_here
VECTOR_DB_URL=http://localhost:8000

# ── EMAIL ─────────────────────────────────────────────────
SUPPORT_EMAIL=your_support_email@example.com
VITE_SUPPORT_EMAIL=your_support_email@example.com
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── SERVER ────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── VITE FRONTEND VARS (must be prefixed VITE_ to be exposed in the browser) ──
VITE_API_BASE=/api
VITE_WA_NUMBER=91XXXXXXXXXX

# ── EMAILJS (optional — alternative to nodemailer for contact form) ──────────
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
